# ============================================================
# NagrikSaarathi (नागरिक सारथी) — Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your local/production environment.
# Never commit actual production secrets or keys to version control.
# ============================================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///nagarik_saarathi.db
ECHO_SQL=false

# Application Environment (development / production)
APP_ENV=development

# Demo Mode:
# When true, permits public access to synthetic/demo analytics.
# When false (production), all dashboard analytics endpoints require admin auth.
DEMO_MODE=true

# Admin API Key for protected dashboard access in production
ADMIN_API_KEY=demo-nagrik-admin-key-2026

# Allowed Frontend Origins (comma-separated for CORS)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional: External Language Provider (e.g., BHASHINI)
# Leave blank to operate using Layer A stored database translations & Layer C fallback
BHASHINI_ENDPOINT=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Language Provider Request Timeout (seconds)
LANGUAGE_PROVIDER_TIMEOUT_SECONDS=5.0

# Maximum Voice Upload Payload Size (in bytes, default: 2MB)
MAX_VOICE_PAYLOAD_BYTES=2097152
